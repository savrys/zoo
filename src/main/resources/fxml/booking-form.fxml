<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.geometry.Insets?>

<GridPane xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1"
          fx:controller="com.zoo.controller.BookingFormController" hgap="10" vgap="10">
    <padding><Insets top="20" right="20" bottom="20" left="20"/></padding>

    <Label text="Посетитель:" GridPane.rowIndex="0" GridPane.columnIndex="0"/>
    <ComboBox fx:id="visitorCombo" GridPane.rowIndex="0" GridPane.columnIndex="1" prefWidth="300"/>

    <Label text="Дата посещения:" GridPane.rowIndex="1" GridPane.columnIndex="0"/>
    <DatePicker fx:id="datePicker" GridPane.rowIndex="1" GridPane.columnIndex="1" prefWidth="300"/>

    <Label text="Время посещения:" GridPane.rowIndex="2" GridPane.columnIndex="0"/>
    <ComboBox fx:id="timeCombo" GridPane.rowIndex="2" GridPane.columnIndex="1" prefWidth="300"/>

    <Label text="Количество билетов:" GridPane.rowIndex="3" GridPane.columnIndex="0"/>
    <TextField fx:id="ticketsField" GridPane.rowIndex="3" GridPane.columnIndex="1" prefWidth="300"/>

    <!-- 👇 НОВОЕ ПОЛЕ: ЦЕНА -->
    <Label text="Цена (руб):" GridPane.rowIndex="4" GridPane.columnIndex="0"/>
    <TextField fx:id="priceField" GridPane.rowIndex="4" GridPane.columnIndex="1" prefWidth="300"/>

    <Label text="Статус:" GridPane.rowIndex="5" GridPane.columnIndex="0"/>
    <ComboBox fx:id="statusCombo" GridPane.rowIndex="5" GridPane.columnIndex="1" prefWidth="300"/>

    <HBox spacing="10" GridPane.rowIndex="6" GridPane.columnIndex="1">
        <Button text="Сохранить" onAction="#onSave" styleClass="btn-primary"/>
        <Button text="Отмена" onAction="#onCancel"/>
    </HBox>
</GridPane>