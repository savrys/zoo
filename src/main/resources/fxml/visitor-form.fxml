<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.geometry.Insets?>
<GridPane xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1"
          fx:controller="com.zoo.controller.VisitorFormController" hgap="10" vgap="10">
    <padding><Insets top="20" right="20" bottom="20" left="20"/></padding>
    <Label text="Имя:" GridPane.rowIndex="0" GridPane.columnIndex="0"/>
    <TextField fx:id="nameField" GridPane.rowIndex="0" GridPane.columnIndex="1" prefWidth="300"/>
    <Label text="Телефон:" GridPane.rowIndex="1" GridPane.columnIndex="0"/>
    <TextField fx:id="phoneField" GridPane.rowIndex="1" GridPane.columnIndex="1" prefWidth="300"/>
    <Label text="Возраст:" GridPane.rowIndex="2" GridPane.columnIndex="0"/>
    <TextField fx:id="ageField" GridPane.rowIndex="2" GridPane.columnIndex="1" prefWidth="300"/>
    <HBox spacing="10" GridPane.rowIndex="3" GridPane.columnIndex="1">
        <Button text="Сохранить" onAction="#onSave" styleClass="btn-primary"/>
        <Button text="Отмена" onAction="#onCancel"/>
    </HBox>
</GridPane>