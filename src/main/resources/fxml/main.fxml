<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.geometry.Insets?>

<BorderPane xmlns="http://javafx.com/javafx/21"
            xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="com.zoo.controller.MainController">

    <top>
        <VBox spacing="8">
            <padding><Insets top="10" right="10" bottom="10" left="10"/></padding>
            <Label text="СИСТЕМА ЗООПАРКА" styleClass="title"/>
        </VBox>
    </top>

    <center>
        <TabPane tabClosingPolicy="UNAVAILABLE">

            <!-- ==================== ВКЛАДКА 1: БРОНИ ==================== -->
            <Tab text="Бронирования">
                <VBox spacing="8">
                    <padding><Insets top="10" right="10" bottom="10" left="10"/></padding>

                    <HBox spacing="10">
                        <TextField fx:id="searchField" promptText="Поиск по имени посетителя" HBox.hgrow="ALWAYS"/>
                        <ComboBox fx:id="statusFilter" promptText="Статус"/>
                        <ComboBox fx:id="sortCombo" promptText="Сортировка"/>
                        <Button text="Найти" onAction="#onSearch"/>
                        <Button text="Сброс" onAction="#onRefresh"/>
                    </HBox>

                    <HBox spacing="10">
                        <Button text="Добавить" onAction="#onAdd" styleClass="btn-primary"/>
                        <Button text="Редактировать" onAction="#onEdit"/>
                        <Button text="Удалить" onAction="#onDelete" styleClass="btn-danger"/>
                        <Button text="Обновить" onAction="#onRefresh"/>
                        <Button text="Экспорт в Excel" onAction="#onExport"/>
                        <Button text="Выход" onAction="#onExit"/>
                    </HBox>

                    <TableView fx:id="table" VBox.vgrow="ALWAYS">
                        <columns>
                            <TableColumn fx:id="colId" text="ID" prefWidth="50"/>
                            <TableColumn fx:id="colVisitor" text="Посетитель" prefWidth="200"/>
                            <TableColumn fx:id="colDate" text="Дата и время" prefWidth="160"/>
                            <TableColumn fx:id="colTickets" text="Билетов" prefWidth="80"/>

                            <!-- КОЛОНКА СУММЫ -->
                            <TableColumn fx:id="colPrice" text="Сумма (руб)" prefWidth="100"/>

                            <TableColumn fx:id="colStatus" text="Статус" prefWidth="130"/>
                        </columns>
                    </TableView>

                    <Label fx:id="statsLabel" styleClass="stats"/>
                </VBox>
            </Tab>

            <!-- ==================== ВКЛАДКА 2: ПОСЕТИТЕЛИ ==================== -->
            <Tab text="Посетители">
                <VBox spacing="8">
                    <padding><Insets top="10" right="10" bottom="10" left="10"/></padding>

                    <HBox spacing="10">
                        <Button text="Добавить посетителя" onAction="#onAddVisitor" styleClass="btn-primary"/>
                        <Button text="Редактировать" onAction="#onEditVisitor"/>
                        <Button text="Удалить" onAction="#onDeleteVisitor" styleClass="btn-danger"/>
                        <Button text="Обновить" onAction="#onRefreshVisitors"/>
                        <Button text="Экспорт в Excel" onAction="#onExportVisitors"/>
                    </HBox>

                    <TableView fx:id="visitorTable" VBox.vgrow="ALWAYS">
                        <columns>
                            <TableColumn fx:id="vColId" text="ID" prefWidth="50"/>
                            <TableColumn fx:id="vColName" text="ФИО" prefWidth="250"/>
                            <TableColumn fx:id="vColEmail" text="Email" prefWidth="200"/>
                            <TableColumn fx:id="vColPhone" text="Телефон" prefWidth="150"/>
                        </columns>
                    </TableView>
                </VBox>
            </Tab>
        </TabPane>
    </center>
</BorderPane>